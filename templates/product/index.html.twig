{% extends 'base.html.twig' %}

{% block title %}Product index{% endblock %}

{% block body %}
<div class="content-card">
    <h1>Product Management</h1>

    <div style="margin-bottom: 2rem;">
        <a href="{{ path('app_product_new') }}" class="btn btn-primary">Create New Product</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Description</th>
                <th>Category</th>
                <th>Price</th>
                <th>Created At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                <td>
                    {% if product.imageUrl %}
                        <img src="{{ asset('image/' ~ product.imageUrl) }}" alt="{{ product.name }}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;">
                    {% else %}
                        <div style="width: 50px; height: 50px; background-color: #f0f0f0; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: #999;">No Image</div>
                    {% endif %}
                </td>
                <td>{{ product.name }}</td>
                <td>{{ product.description|slice(0, 50) ~ (product.description|length > 50 ? '...' : '') }}</td>
                <td>{{ product.category ? product.category.name : 'N/A' }}</td>
                <td>${{ product.price }}</td>
                <td>{{ product.createdAt ? product.createdAt|date('Y-m-d H:i') : '' }}</td>
                <td>
                    <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn btn-secondary">View</a>
                    <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-secondary">Edit</a>
                    {{ include('product/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">No products found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
