<form method="post" action="{{ path('app_user_enable', {'id': user.id}) }}" onsubmit="return confirm('Are you sure you want to enable this user account?')" style="display: inline-block;">
    <input type="hidden" name="_token" value="{{ csrf_token('enable' ~ user.id) }}">
    <button class="btn btn-success">Enable</button>
</form>