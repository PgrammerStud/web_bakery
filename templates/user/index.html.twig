{% extends 'base.html.twig' %}

{% block title %}Staff Management{% endblock %}

{% block body %}
<div class="content-card">
    <h1>Staff Management</h1>

    {% for flash_message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ flash_message }}
        </div>
    {% endfor %}

    <div style="margin-bottom: 2rem;">
        <a href="{{ path('app_user_new') }}" class="btn btn-primary">Create New Staff</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.username }}</td>
                <td>
                    {% for role in user.roles %}
                        {% if role == 'ROLE_ADMIN' %}Admin{% elseif role == 'ROLE_STAFF' %}Staff{% endif %}
                        {% if not loop.last %}, {% endif %}
                    {% endfor %}
                </td>
                <td>
                    <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-secondary">View</a>
                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-secondary">Edit</a>
                    {{ include('user/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">No staff accounts found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
