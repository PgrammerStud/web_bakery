{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
<div class="dashboard-container">
    <h1>Admin Dashboard</h1>

    <div class="dashboard-cards">
        <div class="card">
            <h2>Total Users</h2>
            <p class="metric">{{ totalUsers }}</p>
        </div>

        <div class="card">
            <h2>Total Staff</h2>
            <p class="metric">{{ totalStaff }}</p>
        </div>

        <div class="card">
            <h2>Total Records</h2>
            <p class="metric">{{ totalRecords }}</p>
        </div>

        <div class="card">
            <h2>Total Orders</h2>
            <p class="metric">{{ totalOrders }}</p>
        </div>

        <div class="card">
            <h2>Delivered Orders</h2>
            <p class="metric">{{ totalDelivered }}</p>
        </div>
         
          <div class="card">
            <h2>Pending Orders</h2>
            <p class="metric">{{ totalPending }}</p>
        </div>
      

        <div class="card">
            <h2>Total Donations</h2>
            <p class="metric">${{ totalDonations|number_format(2) }}</p>
        </div>
    </div>

    <div class="recent-activities">
        <h2>Recent Activities</h2>
        <table class="activities-table">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Action</th>
                    <th>Affected Data</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                {% for activity in recentActivities %}
                    <tr>
                        <td>{{ activity.username }}</td>
                        <td>{{ activity.action }}</td>
                        <td>{{ activity.targetData }}</td>
                        <td>{{ activity.createdAt|date('Y-m-d H:i:s') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
