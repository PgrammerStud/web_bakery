
<link rel="stylesheet" href="{{ asset('styles/app.css') }}">

<style>
body {
    display: block !important;
    grid-template-areas: none !important;
    grid-template-columns: none !important;
    grid-template-rows: none !important;
}

/* Responsive registration page styles */
.register-page-wrapper {
    position: relative;
    background-image: url('{{ asset('image/bg4.jpg') }}');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    overflow: visible;
    overflow-y: auto;
}

.register-page-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    z-index: 0;
}

.register-container {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 2rem;
    align-items: center;
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1200px;
}

.register-form-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 450px;
    margin: 0 auto;
    overflow: visible;
}

.bake-it-forward-card {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 20px;
    padding: 2.5rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    border-left: 5px solid #dd8928;
}

.bake-it-forward-card h2 {
    color: #dd8928;
    font-size: 1.8rem;
    font-weight: bold;
    margin: 0 0 1rem 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.bake-it-forward-card .card-icon {
    font-size: 2rem;
}

.bake-it-forward-card p {
    color: #3b2416;
    line-height: 1.6;
    margin: 0.75rem 0;
    font-size: 0.95rem;
}

.bake-it-forward-card .highlight {
    color: #dd8928;
    font-weight: bold;
}

.bake-it-forward-card .feature-list {
    margin: 1.5rem 0;
    padding: 1rem;
    background: rgba(221, 137, 40, 0.05);
    border-radius: 10px;
}

.bake-it-forward-card .feature-item {
    display: flex;
    gap: 0.5rem;
    margin: 0.5rem 0;
    color: #3b2416;
}

.bake-it-forward-card .feature-item::before {
    content: '✓';
    color: #dd8928;
    font-weight: bold;
    min-width: 1.5rem;
}

.register-form-card {
    background-color: var(--white);
    border-radius: 20px;
    padding: 2.25rem 1.75rem;
    box-shadow: var(--shadow-lg);
    position: relative;
    margin-top: 50px;
}

.register-form-card::before {
    content: '';
    position: absolute;
    top: -50px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 80px;
    background: var(--white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-lg);
    background-image: url('/image/monochrome.png');
    background-repeat: no-repeat;
    background-position: center;
    background-size: 60px;
    padding: 0.75rem;
    z-index: 10;
}

.register-form-card h1 {
    font-family: 'Pacifico', cursive;
    color: var(--primary-brown);
    text-align: center;
    margin-bottom: 1.25rem;
    margin-top: 0.75rem;
    font-size: 1.7rem;
    font-weight: 400;
}

.register-form-card .form-group {
    margin-bottom: 1.1rem;
}

.register-form-card label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-dark);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.5px;
    font-family: 'Open Sans Condensed', sans-serif;
}

.register-form-card .form-control {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 3rem;
    border: 2px solid var(--gray-medium);
    border-radius: 10px;
    font-family: 'Open Sans Condensed', sans-serif;
    font-size: 0.95rem;
    transition: var(--transition);
    background-color: var(--gray-light);
}

.register-form-card .form-control:focus {
    outline: none;
    border-color: var(--primary-brown);
    background-color: var(--white);
    box-shadow: 0 0 0 4px rgba(59, 36, 22, 0.1);
}

.register-form-card .checkbox {
    display: flex;
    align-items: center;
    margin-bottom: 1.25rem;
    margin-top: 1rem;
}

.register-form-card .checkbox label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-weight: 400;
    text-transform: none;
    font-size: 0.95rem;
    cursor: pointer;
    color: var(--gray-dark);
}

.register-form-card .checkbox input[type="checkbox"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: var(--primary-brown);
    border-radius: 4px;
}

.register-form-card .btn-primary {
    width: 100%;
    padding: 0.9rem;
    background-color: var(--primary-orange);
    color: var(--white);
    border: none;
    border-radius: 10px;
    font-family: 'Open Sans Condensed', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: var(--transition);
    margin-bottom: 0.75rem;
}

.register-form-card .btn-primary:hover {
    background-color: #c97a23;
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.register-form-card .register-link {
    text-align: center;
    margin-top: 1rem;
    color: var(--color-text-muted);
}

.register-form-card .register-link a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
}

.register-form-card .register-link a:hover {
    text-decoration: underline;
}

.register-form-card .alert {
    padding: 1rem;
    border-radius: 10px;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
    font-family: 'Open Sans Condensed', sans-serif;
}

.register-form-card .alert-danger {
    background-color: #ffe6e6;
    color: #d32f2f;
    border: 1px solid #ffcdd2;
}

.register-form-card .input-wrapper {
    position: relative;
}

.register-form-card .input-wrapper::before {
    content: '';
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    z-index: 1;
}

.register-form-card .input-wrapper.username-field::before {
    background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="%233b2416" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>') center/contain no-repeat;
}

.register-form-card .input-wrapper.password-field::before {
    background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="%233b2416" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>') center/contain no-repeat;
}

/* Responsive styles */
@media (max-width: 1024px) {
    .register-container {
        grid-template-columns: 1fr;
    }

    .register-page-wrapper {
        padding: 1.5rem;
    }

    .bake-it-forward-card {
        padding: 2rem;
    }
}

@media (max-width: 768px) {
    .register-page-wrapper {
        padding: 1.25rem;
        align-items: flex-start;
        padding-top: 2rem;
        padding-bottom: 2rem;
    }

    .register-container {
        gap: 1.5rem;
    }

    .bake-it-forward-card {
        padding: 1.75rem;
    }

    .bake-it-forward-card h2 {
        font-size: 1.5rem;
    }

    .register-form-card {
        padding: 2rem 1.75rem;
        margin-top: 45px;
    }

    .register-form-card::before {
        width: 70px;
        height: 70px;
        background-size: 50px;
        top: -50px;
    }

    .register-form-card h1 {
        font-size: 1.4rem;
        margin-bottom: 1.1rem;
        margin-top: 1.25rem;
    }

    .register-form-card .form-group {
        margin-bottom: 1rem;
    }

    .register-form-card .form-control {
        padding: 0.7rem 0.875rem 0.7rem 2.75rem;
        font-size: 0.9rem;
    }
}

@media (max-width: 480px) {
    .register-page-wrapper {
        padding: 0.75rem;
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
        align-items: flex-start;
    }

    .register-container {
        gap: 1rem;
    }

    .bake-it-forward-card {
        padding: 1.5rem;
    }

    .bake-it-forward-card h2 {
        font-size: 1.3rem;
    }

    .bake-it-forward-card p {
        font-size: 0.9rem;
    }

    .bake-it-forward-card .feature-list {
        padding: 0.75rem;
        margin: 1.25rem 0;
    }

    .bake-it-forward-card .feature-item {
        font-size: 0.85rem;
        margin: 0.4rem 0;
    }

    .register-form-card {
        padding: 1.5rem 1.25rem;
        border-radius: 15px;
        max-width: 100%;
        margin-top: 40px;
    }

    .register-form-card::before {
        width: 65px;
        height: 65px;
        background-size: 45px;
        top: -45px;
    }

    .register-form-card h1 {
        font-size: 1.25rem;
        margin-bottom: 0.9rem;
        margin-top: 1rem;
    }

    .register-form-card .form-group {
        margin-bottom: 0.85rem;
    }

    .register-form-card label {
        font-size: 0.75rem;
    }

    .register-form-card .form-control {
        padding: 0.65rem 0.75rem 0.65rem 2.5rem;
        font-size: 0.85rem;
        border-radius: 8px;
    }

    .register-form-card .btn-primary {
        padding: 0.8rem;
        font-size: 0.95rem;
        border-radius: 8px;
        margin-bottom: 0.65rem;
    }

    .register-form-card .checkbox {
        margin-bottom: 1rem;
        margin-top: 0.85rem;
    }
}
</style>

{% block title %}{% endblock %}

{% block body %}
<div class="main">
    <div class="register-page-wrapper">
        <div class="register-container">
            <!-- Bake It Forward Info Card -->
            <div class="bake-it-forward-card">
                <h2><span class="card-icon">🐾</span>Bake It Forward</h2>
                <p>At <span class="highlight">Catalbas Bakery</span>, we believe in giving back to our community.</p>
                
                <div class="feature-list">
                    <div class="feature-item">Every purchase contributes to local animal shelters</div>
                    <div class="feature-item">We partner with rescue centers for cats and dogs</div>
                    <div class="feature-item">A portion of every sale goes directly to animal care</div>
                    <div class="feature-item">Help us make a difference with every order</div>
                </div>
                
                <p style="margin-top: 1.5rem; font-size: 0.9rem; color: #666; font-style: italic;">
                    "We don't just bake for sustenance—we bake for memories, celebrations, <span class="highlight">and making a difference.</span>"
                </p>
            </div>

            <!-- Register Form Card -->
            <div class="register-form-container">
                <form method="post" class="register-form-card">
            
            {% if form_errors(registrationForm) %}
                <div class="alert alert-danger" style="margin-bottom: 1rem;">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            <h1>Create your account</h1>

            <div class="form-group">
                <label for="inputLastname">Last Name</label>
                <div class="input-wrapper username-field">
                    {{ form_widget(registrationForm.lastname, {'attr': {'id': 'inputLastname', 'class': 'form-control', 'placeholder': 'Enter your lastname'}}) }}
                </div>
                {{ form_errors(registrationForm.lastname) }}
            </div>

            <div class="form-group">
                <label for="inputFirstname">First Name</label>
                <div class="input-wrapper username-field">
                    {{ form_widget(registrationForm.firstname, {'attr': {'id': 'inputFirstname', 'class': 'form-control', 'placeholder': 'Enter your firstname'}}) }}
                </div>
                {{ form_errors(registrationForm.firstname) }}
            </div>

            <div class="form-group">
                <label for="inputUsername">Username</label>
                <div class="input-wrapper username-field">
                    {{ form_widget(registrationForm.username, {'attr': {'id': 'inputUsername', 'class': 'form-control', 'placeholder': 'Enter your username'}}) }}
                </div>
                {{ form_errors(registrationForm.username) }}
            </div>

            <div class="form-group">
                <label for="inputEmail">Email</label>
                <div class="input-wrapper username-field">
                    {{ form_widget(registrationForm.email, {'attr': {'id': 'inputEmail', 'class': 'form-control', 'placeholder': 'Enter your email'}}) }}
                </div>
                {{ form_errors(registrationForm.email) }}
            </div>

            <div class="form-group">
                <label for="inputPassword">Password</label>
                <div class="input-wrapper password-field">
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'id': 'inputPassword', 'class': 'form-control', 'placeholder': 'Enter your password'}}) }}
                </div>
                {{ form_errors(registrationForm.plainPassword) }}
            </div>

            <div class="checkbox mb-3">
                <label>
                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': ''}}) }} I agree to the terms
                </label>
                {{ form_errors(registrationForm.agreeTerms) }}
            </div>

            {{ form_rest(registrationForm) }}

            <button class="btn-primary" type="submit">Register</button>

            <p class="register-link">
                Already have an account?
                <a href="/login">Sign in</a>
            </p>
            </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}