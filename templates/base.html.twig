<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="Catalbas Bakery - Fresh Baked Goods Delivered to Your Door">
        <meta name="theme-color" content="#3b2416">
        <title>{% block title %}Catalbas Bakery - Fresh Baked Goods{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {# ===== MERCURE STYLES ===== #}
        <style>
#toast-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.toast {
    min-width: 360px;
    max-width: 480px;
    background: #fff;
    border-left: 6px solid #3b2416;
    border-radius: 10px;
    padding: 18px 22px;
    box-shadow: 0 6px 24px rgba(0,0,0,0.15);
    font-size: 15px;
    animation: slideIn 0.3s ease;
}
.toast.success { border-left-color: #22c55e; }
.toast.info    { border-left-color: #3b82f6; }
.toast.warning { border-left-color: #f59e0b; }
.toast.error   { border-left-color: #ef4444; }
.toast-title   { font-weight: 700; font-size: 16px; margin-bottom: 6px; }
.toast-message { color: #555; font-size: 14px; line-height: 1.5; }
@keyframes slideIn {
    from { transform: translateX(100%); opacity: 0; }
    to   { transform: translateX(0);    opacity: 1; }
}

            /* Notification bell */
            .notif-bell-wrapper {
                position: relative;
                display: inline-block;
                cursor: pointer;
                margin-left: 16px;
            }
            .notif-bell-wrapper svg {
                width: 24px;
                height: 24px;
                fill: none;
                stroke: currentColor;
                stroke-width: 2;
                vertical-align: middle;
            }
            .notif-badge {
                position: absolute;
                top: -6px;
                right: -6px;
                background: #ef4444;
                color: #fff;
                font-size: 11px;
                font-weight: 700;
                border-radius: 50%;
                width: 18px;
                height: 18px;
                display: none;
                align-items: center;
                justify-content: center;
            }
            .notif-dropdown {
                display: none;
                position: absolute;
                right: 0;
                top: 36px;
                width: 320px;
                background: #fff;
                border: 1px solid #e5e7eb;
                border-radius: 10px;
                box-shadow: 0 8px 24px rgba(0,0,0,0.12);
                z-index: 9999;
                overflow: hidden;
            }
            .notif-dropdown.open { display: block; }
            .notif-dropdown-header {
                padding: 12px 16px;
                font-weight: 600;
                font-size: 14px;
                border-bottom: 1px solid #e5e7eb;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .notif-clear-btn {
                font-size: 12px;
                color: #3b82f6;
                cursor: pointer;
                background: none;
                border: none;
            }
            .notif-list {
                max-height: 320px;
                overflow-y: auto;
            }
            .notif-item {
                padding: 10px 16px;
                border-bottom: 1px solid #f3f4f6;
                font-size: 13px;
            }
            .notif-item:last-child { border-bottom: none; }
            .notif-item-title { font-weight: 500; margin-bottom: 2px; }
            .notif-item-time  { color: #9ca3af; font-size: 11px; }
            .notif-empty {
                padding: 24px;
                text-align: center;
                color: #9ca3af;
                font-size: 13px;
            }
        </style>
    </head>
    <body{% if not is_granted('ROLE_ADMIN') and not is_granted('ROLE_STAFF') %} class="customer-view"{% endif %}>
        <header class="header">
            <img src="{{ asset('image/monochrome.png') }}" alt="Catalbas Bakery" class="logo">
            <nav class="header-nav">
                <a href="{{ path('app_profile') }}">Profile</a>
                <a href="{{ path('app_logout') }}">Logout</a>

                {# ===== NOTIFICATION BELL (admin/staff only) ===== #}
                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
                <div class="notif-bell-wrapper" id="notif-bell" title="Notifications">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    <span class="notif-badge" id="notif-badge">0</span>

                    <div class="notif-dropdown" id="notif-dropdown">
                        <div class="notif-dropdown-header">
                            Notifications
                            <button class="notif-clear-btn" id="notif-clear">Clear all</button>
                        </div>
                        <div class="notif-list" id="notif-list">
                            <div class="notif-empty" id="notif-empty">No notifications yet</div>
                        </div>
                    </div>
                </div>
                {% endif %}
            </nav>
        </header>

        {% for flash_message in app.flashes('success') %}
            <div class="alert alert-success" role="alert">{{ flash_message }}</div>
        {% endfor %}
        {% set error_flashes = app.flashes('error') %}
        {% for flash_message in error_flashes %}
            <div class="alert alert-error" role="alert">{{ flash_message }}</div>
        {% endfor %}
        {% for flash_message in error_flashes %}
        <script>alert('{{ flash_message }}');</script>
        {% endfor %}

        <aside class="sidebar">
            <ul>
                {% if is_granted('ROLE_ADMIN') %}
                    <li><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
                    <li><a href="{{ path('app_order_index') }}">Order Management</a></li>
                    <li><a href="{{ path('app_category_index') }}">Category Management</a></li>
                    <li><a href="{{ path('app_stock_index') }}">Stock Management</a></li>
                    <li><a href="{{ path('app_product_index') }}">Product Management</a></li>
                    <li><a href="{{ path('app_user_index') }}">Staff Management</a></li>
                    <li><a href="{{ path('app_bakeitforward_index') }}">Bake It Forward</a></li>
                    <li><a href="{{ path('app_delivery_index') }}">Delivery</a></li>
                    <li><a href="{{ path('app_activity_log') }}">Activity Log</a></li>
                {% elseif is_granted('ROLE_STAFF') %}
                    <li><a href="{{ path('app_order_index') }}">Order Management</a></li>
                    <li><a href="{{ path('app_category_index') }}">Category Management</a></li>
                    <li><a href="{{ path('app_stock_index') }}">Stock Management</a></li>
                    <li><a href="{{ path('app_product_index') }}">Product Management</a></li>
                {% endif %}
            </ul>
        </aside>

        <main class="main-content">
            {% block body %}{% endblock %}
        </main>

        {# ===== TOAST CONTAINER ===== #}
        <div id="toast-container"></div>

        {# ===== MERCURE JAVASCRIPT (admin/staff only) ===== #}
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
<script>
    // ── Toast ──────────────────────────────────────────────
    function showToast(title, message, type = 'success') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = 'toast ' + type;
        toast.innerHTML = `<div class="toast-title">${title}</div><div class="toast-message">${message}</div>`;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 5000);
    }

    // ── Notification bell ──────────────────────────────────
    let notifCount = 0;

    function addNotification(title, message) {
        notifCount++;
        const badge  = document.getElementById('notif-badge');
        const list   = document.getElementById('notif-list');
        const empty  = document.getElementById('notif-empty');

        badge.style.display = 'flex';
        badge.textContent   = notifCount;

        if (empty) empty.remove();

        const item = document.createElement('div');
        item.className = 'notif-item';
        item.innerHTML = `
            <div class="notif-item-title">${title}</div>
            <div class="toast-message">${message}</div>
            <div class="notif-item-time">${new Date().toLocaleTimeString()}</div>
        `;
        list.prepend(item);
    }

    // ── Bell toggle ────────────────────────────────────────
    document.addEventListener('click', function(e) {
        const bell     = document.getElementById('notif-bell');
        const dropdown = document.getElementById('notif-dropdown');
        const clearBtn = document.getElementById('notif-clear');

        if (!bell || !dropdown) return;

        if (clearBtn && clearBtn.contains(e.target)) {
            e.stopPropagation();
            const list = document.getElementById('notif-list');
            list.innerHTML = '<div class="notif-empty" id="notif-empty">No notifications yet</div>';
            notifCount = 0;
            document.getElementById('notif-badge').style.display = 'none';
            return;
        }

        if (bell.contains(e.target)) {
            e.stopPropagation();
            dropdown.classList.toggle('open');
            if (dropdown.classList.contains('open')) {
                notifCount = 0;
                document.getElementById('notif-badge').style.display = 'none';
                document.getElementById('notif-badge').textContent = '0';
            }
            return;
        }

        dropdown.classList.remove('open');
    });

    // ── Mercure ────────────────────────────────────────────
    const MERCURE_PUBLIC_URL = '{{ mercure_public_url }}';  

    function connectMercure(topic, handler) {                
        const url = new URL(MERCURE_PUBLIC_URL);
        url.searchParams.append('topic', topic);
        console.log('🔗 Connecting to Mercure topic:', topic);
        const es = new EventSource(url.toString());
        es.onmessage = (e) => {
            console.log('📨 Message received on topic', topic, ':', e.data);
            handler(JSON.parse(e.data));
        };
        es.onerror   = () => console.warn('⚠️ Mercure reconnecting: ' + topic);
    }

    // ── Listeners (wrapped in DOMContentLoaded) ────────────
    document.addEventListener('DOMContentLoaded', function () {
        console.log('✅ DOMContentLoaded - Setting up Mercure listeners');

        connectMercure('/orders/new', function(data) {
            console.log('📦 New order received:', data);
            showToast('🧁 New Order!', 'Order ' + data.orderNumber + ' placed by ' + data.customer, 'success');
            addNotification('New Order', 'Order ' + data.orderNumber + ' placed by ' + data.customer);
            if (typeof onNewOrder === 'function') onNewOrder(data);
        });

        connectMercure('/orders/paid', function(data) {
            console.log('💳 Order paid received:', data);
            showToast('💰 Order Paid', 'Order ' + data.orderNumber + ' has been paid!', 'success');
            addNotification('Order Paid', 'Order ' + data.orderNumber + ' — ' + data.customer + ' paid successfully');
            if (typeof onOrderPaid === 'function') onOrderPaid(data);
        });

        connectMercure('/notifications/new', function(data) {
            console.log('🔔 Notification received:', data);
            if (data.type !== 'new_order' && data.type !== 'order_paid') {
                showToast('Notification', data.message, data.type);
            }
        });

        connectMercure('/donations/new', function(data) {
            console.log('🎁 Donation received:', data);
            showToast('🍰 Bake It Forward', 'New donation of ₱' + data.amount + ' from ' + data.donor, 'info');
            addNotification('New Donation', data.donor + ' donated ₱' + data.amount);
            if (typeof onNewDonation === 'function') onNewDonation(data);
        });

        connectMercure('/activity-log/new', function(data) {
    console.log('📋 Activity log received:', data);
    if (typeof onNewActivityLog === 'function') onNewActivityLog(data);
});

        connectMercure('/dashboard/update', function(data) {
    console.log('📊 Dashboard update received:', data);
    if (typeof onDashboardUpdate === 'function') {
        console.log('✅ Calling onDashboardUpdate');
        onDashboardUpdate(data);
    } else {
        console.warn('❌ onDashboardUpdate function not found');
    }
});

    });
</script>
{% endif %}
    </body>
</html>