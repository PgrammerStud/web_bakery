<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="header">
            <img src="{{ asset('image/monochrome.png') }}" alt="Catalbas Bakery" class="logo">
            <nav class="header-nav">
                <a href="{{ path('app_profile') }}">Profile</a>
                <a href="{{ path('app_logout') }}">Logout</a>
            </nav>
        </header>

        {% for flash_message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ flash_message }}
            </div>
        {% endfor %}
        {% set error_flashes = app.flashes('error') %}
        {% for flash_message in error_flashes %}
            <div class="alert alert-error">
                {{ flash_message }}
            </div>
        {% endfor %}

        {% for flash_message in error_flashes %}
        <script>
            alert('{{ flash_message }}');
        </script>
        {% endfor %}

        <aside class="sidebar">
            <ul>
                {% if is_granted('ROLE_ADMIN') %}
                    <li><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
                    <li><a href="{{ path('app_order_index') }}">Order Management</a></li>
                    <li><a href="{{ path('app_category_index') }}">Category Management</a></li>
                    <li><a href="{{ path('app_stock_index') }}">Stock Management</a></li>
                    <li><a href="{{ path('app_product_index') }}">Product Management</a></li>
                    <li><a href="{{ path('app_user_index') }}">Staff Management</a></li>
                    <li><a href="{{ path('app_bakeitforward_index') }}">Bake It Forward</a></li>
                    <li><a href="{{ path('app_delivery_index') }}">Delivery</a></li>
                    <li><a href="{{ path('app_activity_log') }}">Activity Log</a></li>
                    
                {% elseif is_granted('ROLE_STAFF') %}
                    <li><a href="{{ path('app_order_index') }}">Order Management</a></li>
                    <li><a href="{{ path('app_category_index') }}">Category Management</a></li>
                    <li><a href="{{ path('app_stock_index') }}">Stock Management</a></li>
                    <li><a href="{{ path('app_product_index') }}">Product Management</a></li>
                {% endif %}
            </ul>
        </aside>

        <main class="main-content">
            {% block body %}{% endblock %}
        </main>

    </body>
</html>
