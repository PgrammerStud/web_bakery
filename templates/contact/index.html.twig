{% extends 'landing.html.twig' %}

{% block title %}Contact Catalbas Bakery - Get In Touch{% endblock %}

{% block body %}
    <!-- CONTACT HERO SECTION -->
    <section class="contact-hero" id="contact-hero">
        <div class="contact-hero-background" style="background-image: url('{{ asset('image/contact.jpg') }}'); background-color: #dd8928;">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <h1 class="hero-title">Contact Us</h1>
                <p class="hero-subtitle">We'd Love to Hear From You - Reach Out Anytime</p>
            </div>
        </div>
        
        <style>
            .contact-hero {
                position: relative;
                overflow: hidden;
            }

            .contact-hero-background {
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                padding: 4rem 2rem;
                position: relative;
            }

            .contact-hero-background::before {
                content: '';
                position: absolute;
                inset: 0;
                background-image: url('{{ asset('image/contact.jpg') }}');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                filter: blur(5px);
                z-index: 1;
            }

            .hero-overlay {
                position: absolute;
                inset: 0;
                background: rgba(59, 36, 22, 0.5);
                z-index: 2;
            }

            .hero-content {
                position: relative;
                z-index: 3;
                text-align: center;
                color: white;
            }

            .hero-title {
                font-size: 3rem;
                font-weight: bold;
                margin: 0 0 1rem 0;
            }

            .hero-subtitle {
                font-size: 1.2rem;
                margin: 0;
                opacity: 0.9;
            }

            /* Get In Touch Section Styling */
            #contact-info-section h2 {
                color: #dd8928;
                font-size: 2.5rem;
                font-weight: bold;
                margin-bottom: 0.5rem;
            }

            #contact-info-section .section-subtitle {
                color: #dd8928;
                font-size: 1.1rem;
                font-weight: 600;
            }

            /* FAQ Section Styling */
            #contact-faq h2 {
                color: #dd8928;
                font-size: 2.5rem;
                font-weight: bold;
                margin-bottom: 2rem;
            }

            /* Mobile Responsive Styles for Hero */
            @media (max-width: 768px) {
                .contact-hero-background {
                    padding: 2rem 1rem;
                }

                .hero-title {
                    font-size: 2rem;
                }

                .hero-subtitle {
                    font-size: 1rem;
                }

                #contact-info-section h2 {
                    font-size: 1.8rem;
                }

                #contact-info-section .section-subtitle {
                    font-size: 1rem;
                }
            }

            @media (max-width: 480px) {
                .contact-hero-background {
                    padding: 1.5rem 1rem;
                }

                .hero-title {
                    font-size: 1.5rem;
                }

                .hero-subtitle {
                    font-size: 0.9rem;
                }
            }
        </style>
    </section>

    <!-- CONTACT INFORMATION SECTION -->
    <section class="contact-info-section" id="contact-info-section" style="background-image: url('{{ asset('image/contact.jpg') }}'); background-size: cover; background-position: center; background-attachment: fixed; padding: 4rem 2rem;">
        <div class="container">
            <h2>Get In Touch</h2>
            <p class="section-subtitle">Multiple ways to reach us</p>
            
            <div class="contact-grid">
                <div class="contact-info-box">
                    <div class="info-icon">📍</div>
                    <h3>Visit Us</h3>
                    <p>
                        <strong>Catalbas Bakery</strong><br>
                        123 Larena Street<br>
                        Valencia, Philippines 1000
                    </p>
                </div>

                <div class="contact-info-box">
                    <div class="info-icon">📞</div>
                    <h3>Call Us</h3>
                    <p>
                        <strong>Main Line:</strong><br>
                        +63 (02) 1234-5678<br>
                        <strong>Mobile:</strong><br>
                        +63 9395929110
                    </p>
                </div>

                <div class="contact-info-box">
                    <div class="info-icon">✉️</div>
                    <h3>Email Us</h3>
                    <p>
                        <strong>General Inquiries:</strong><br>
                        desireeadie143000@gmail.com<br>
                        <strong>Orders:</strong><br>
                        desireeadie143000@gmail.com
                    </p>
                </div>

                <div class="contact-info-box">
                    <div class="info-icon">🕐</div>
                    <h3>Business Hours</h3>
                    <p>
                        <strong>Monday - Friday:</strong> 6:00 AM - 8:00 PM<br>
                        <strong>Saturday - Sunday:</strong> 7:00 AM - 9:00 PM<br>
                        <strong>Holidays:</strong> 8:00 AM - 6:00 PM
                    </p>
                </div>

                <div class="contact-info-box">
                    <div class="info-icon">🚚</div>
                    <h3>Delivery</h3>
                    <p>
                        Same-day delivery available<br>
                        Free delivery for orders over ₱500<br>
                    </p>
                </div>

                <div class="contact-info-box">
                    <div class="info-icon">🌐</div>
                    <h3>Follow Us</h3>
                    <p>
                        <strong>Social Media:</strong><br>
                        Facebook: @CatalbAsBakery<br>
                        Instagram: @CatalbAsBakery
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACT INFO CARDS RESPONSIVE STYLES -->
    <style>
        /* Contact Grid Layout */
        #contact-info-section {
            padding: 3rem 1rem !important;
        }

        #contact-info-section .container {
            padding: 0 1rem;
        }

        #contact-info-section h2 {
            margin-bottom: 1rem;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .contact-info-box {
            background-color: rgba(255, 248, 240, 0.95);
            padding: 2rem 1.5rem;
            border-radius: 10px;
            border-left: 4px solid #dd8928;
            transition: all 0.3s ease;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .contact-info-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
        }

        .info-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            display: inline-block;
        }

        .contact-info-box h3 {
            color: #dd8928;
            margin-bottom: 1rem;
            font-size: 1.3rem;
            font-weight: 600;
        }

        .contact-info-box p {
            color: #5a3e28;
            line-height: 1.8;
            font-size: 0.95rem;
            margin: 0;
        }

        /* Tablet Responsive */
        @media (max-width: 768px) {
            #contact-info-section {
                padding: 2.5rem 1rem !important;
            }

            .contact-grid {
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                gap: 1.5rem;
                margin-top: 1.5rem;
            }

            .contact-info-box {
                padding: 1.5rem 1.25rem;
            }

            .info-icon {
                font-size: 2rem;
                margin-bottom: 0.75rem;
            }

            .contact-info-box h3 {
                font-size: 1.1rem;
                margin-bottom: 0.75rem;
            }

            .contact-info-box p {
                font-size: 0.9rem;
            }

            #contact-info-section h2 {
                font-size: 1.8rem;
            }
        }

        /* Mobile Responsive - Small phones */
        @media (max-width: 480px) {
            #contact-info-section {
                padding: 2rem 0.75rem !important;
            }

            #contact-info-section .container {
                padding: 0 0.75rem;
            }

            .contact-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
                margin-top: 1rem;
            }

            .contact-info-box {
                padding: 1.25rem 1rem;
                border-radius: 8px;
            }

            .info-icon {
                font-size: 1.75rem;
                margin-bottom: 0.5rem;
            }

            .contact-info-box h3 {
                font-size: 1rem;
                margin-bottom: 0.5rem;
            }

            .contact-info-box p {
                font-size: 0.85rem;
                line-height: 1.6;
            }

            #contact-info-section h2 {
                font-size: 1.5rem;
                margin-bottom: 0.5rem;
            }

            #contact-info-section .section-subtitle {
                font-size: 0.9rem;
            }
        }
    </style>

    <!-- CONTACT FORM SECTION -->
    <section class="contact-form-section" id="contact-form-section">
        <div class="container">
            <div class="contact-form-wrapper">
                <!-- Left Side - Image -->
                <div class="contact-form-image">
                    <img src="{{ asset('image/contact us.jpg') }}" alt="Fresh baked bread from Catalbas Bakery" class="contact-image">
                    <div class="contact-image-overlay">
                        <p class="contact-message-cta">We'd love to hear from you!</p>
                    </div>
                </div>

                <!-- Right Side - Form -->
                <div class="contact-form-content">
                    <h2>Send Us a Message</h2>
                    <p class="section-subtitle">We'll respond to your inquiry within 24 hours</p>
                    
                    <div class="contact-form-container">
                        <!-- DEBUG: Show all variables -->
                        <!-- formSubmitted: {{ formSubmitted ? 'YES' : 'NO' }} | formSuccess: {{ formSuccess ? 'YES' : 'NO' }} | formError: {{ formError ?? 'NONE' }} -->
                        
                        {% if formSubmitted %}
                            {% if formSuccess %}
                                <div class="alert alert-success" role="alert">
                                    <div class="alert-icon"></div>
                                    <div class="alert-content">
                                        <h3>Message Sent Successfully!</h3>
                                        <p>Thank you for contacting Catalbas Bakery. We've received your message and will get back to you shortly.</p>
                                        <p>A confirmation email has been sent to your inbox.</p>
                                    </div>
                                </div>
                            {% else %}
                                <div class="alert alert-error" role="alert">
                                    <div class="alert-icon">✕</div>
                                    <div class="alert-content">
                                        <h3>Oops! Something went wrong</h3>
                                        <p>{{ formError }}</p>
                                    </div>
                                </div>
                            {% endif %}
                        {% endif %}

                        <form method="POST" action="{{ path('app_contact') }}" class="contact-form" data-turbo="false">
                            <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="contact-name">Full Name *</label>
                                    <input 
                                        type="text" 
                                        id="contact-name" 
                                        name="name" 
                                        value="{{ formData.name ?? '' }}"
                                        required 
                                        placeholder="Your Full Name"
                                        class="form-control">
                                </div>
                                <div class="form-group">
                                    <label for="contact-phone">Phone Number</label>
                                    <input 
                                        type="tel" 
                                        id="contact-phone" 
                                        name="phone" 
                                        value="{{ formData.phone ?? '' }}"
                                        placeholder="Your Phone Number"
                                        class="form-control">
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="contact-email">Email Address *</label>
                                <input 
                                    type="email" 
                                    id="contact-email" 
                                    name="email" 
                                    value="{{ formData.email ?? '' }}"
                                    required 
                                    placeholder="your@email.com"
                                    class="form-control">
                            </div>

                            <div class="form-group">
                                <label for="contact-subject">Subject *</label>
                                <select id="contact-subject" name="subject" value="{{ formData.subject ?? '' }}" required class="form-control">
                                    <option value="">-- Select a Subject --</option>
                                    <option value="General Inquiry" {% if formData.subject == 'General Inquiry' %}selected{% endif %}>General Inquiry</option>
                                    <option value="Custom Order" {% if formData.subject == 'Custom Order' %}selected{% endif %}>Custom Order</option>
                                    <option value="Bulk Order" {% if formData.subject == 'Bulk Order' %}selected{% endif %}>Bulk Order</option>
                                    <option value="Feedback" {% if formData.subject == 'Feedback' %}selected{% endif %}>Feedback</option>
                                    <option value="Partnership Opportunity" {% if formData.subject == 'Partnership Opportunity' %}selected{% endif %}>Partnership Opportunity</option>
                                    <option value="Other" {% if formData.subject == 'Other' %}selected{% endif %}>Other</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="contact-message">Message *</label>
                                <textarea 
                                    id="contact-message" 
                                    name="message" 
                                    rows="6" 
                                    required 
                                    placeholder="Tell us how we can help you..."
                                    class="form-control">{{ formData.message ?? '' }}</textarea>
                            </div>

                            <div class="form-group checkbox">
                                <input type="checkbox" id="contact-subscribe" name="subscribe" value="1" {% if formData.subscribe %}checked{% endif %}>
                                <label for="contact-subscribe">Subscribe to our newsletter for updates and special offers</label>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg btn-block">Send Message</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <style>
            /* Contact Form Section */
            .contact-form-section {
                background: url('{{ asset('image/contact.jpg') }}');
                background-size: cover;
                background-position: center;
                background-attachment: fixed;
                padding: 4rem 2rem;
                border-radius: 12px;
            }

            .contact-form-wrapper {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 3rem;
                align-items: center;
                margin-top: 3rem;
                background: var(--primary-orange);
                padding: 3rem;
                border-radius: 12px;
            }

            .contact-form-image {
                position: relative;
                height: 400px;
                border-radius: 12px;
                overflow: hidden;
                box-shadow: var(--shadow-lg);
                background: var(--primary-orange);
            }

            .contact-image {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.3s ease;
            }

            .contact-form-image:hover .contact-image {
                transform: scale(1.05);
            }

            .contact-image-overlay {
                position: absolute;
                inset: 0;
                background: rgba(59, 36, 22, 0.6);
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            .contact-form-image:hover .contact-image-overlay {
                opacity: 1;
            }

            .contact-message-cta {
                color: white;
                font-size: 1.5rem;
                font-weight: 700;
                text-align: center;
                margin: 0;
            }

            .contact-form-content {
                padding: 2rem;
                background: var(--primary-brown);
                border-radius: 12px;
                box-shadow: var(--shadow-md);
            }

            .contact-form-content h2 {
                font-size: 2rem;
                color: var(--primary-orange);
                margin-top: 0;
                margin-bottom: 0.5rem;
            }

            /* Form Elements Responsive */
            .form-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1rem;
            }

            .form-group {
                display: flex;
                flex-direction: column;
                margin-bottom: 1rem;
            }

            .form-group label {
                margin-bottom: 0.5rem;
                color: var(--primary-orange);
                font-weight: 600;
                font-size: 0.9rem;
            }

            .form-control {
                padding: 0.875rem;
                border: 1px solid rgba(255, 248, 240, 0.3);
                border-radius: 8px;
                background: rgba(255, 248, 240, 0.95);
                font-size: 1rem;
                transition: all 0.3s ease;
            }

            .form-control:focus {
                outline: none;
                border-color: var(--primary-orange);
                box-shadow: 0 0 0 3px rgba(221, 137, 40, 0.2);
                background: white;
            }

            /* Checkbox Styling */
            .form-group.checkbox {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                margin-bottom: 1.5rem;
            }

            .form-group.checkbox input[type="checkbox"] {
                margin-top: 0.35rem;
                width: 18px;
                height: 18px;
                cursor: pointer;
                accent-color: #dd8928;
            }

            .form-group.checkbox label {
                margin-bottom: 0;
                color: black;
                font-weight: 400;
                font-size: 0.9rem;
                cursor: pointer;
            }

            /* Button Styling */
            .btn {
                display: inline-block;
                padding: 0.75rem 1.5rem;
                border: none;
                border-radius: 8px;
                font-size: 1rem;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.3s ease;
                text-decoration: none;
            }

            .btn-primary {
                background: #dd8928;
                color: white;
            }

            .btn-primary:hover {
                background: #c47820;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(221, 137, 40, 0.3);
            }

            .btn-lg {
                padding: 1rem 2rem;
                font-size: 1.1rem;
            }

            .btn-block {
                width: 100%;
                display: block;
            }


            /* Tablet Responsive - 768px and below */
            @media (max-width: 768px) {
                .contact-form-section {
                    padding: 2.5rem 1.5rem;
                }

                .contact-form-wrapper {
                    grid-template-columns: 1fr;
                    gap: 2rem;
                    padding: 2rem;
                }

                .contact-form-image {
                    height: 280px;
                    display: none;
                }

                .contact-form-content {
                    padding: 1.5rem;
                }

                .contact-form-content h2 {
                    font-size: 1.5rem;
                    margin-bottom: 0.25rem;
                }

                .form-row {
                    grid-template-columns: 1fr;
                    gap: 0.75rem;
                }

                .form-control {
                    padding: 0.75rem;
                    font-size: 16px;
                }
            }

            /* Mobile Responsive - 480px and below */
            @media (max-width: 480px) {
                .contact-form-section {
                    padding: 1.5rem 0;
                    border-radius: 0;
                }

                .contact-form-wrapper {
                    grid-template-columns: 1fr;
                    gap: 0;
                    padding: 0;
                    border-radius: 0;
                    background: none;
                }

                .contact-form-content {
                    padding: 1.5rem 1rem;
                    border-radius: 0;
                    background: var(--primary-brown);
                    width: 100%;
                }

                .contact-form-content h2 {
                    font-size: 1.25rem;
                    margin-bottom: 0.5rem;
                    margin-top: 0;
                }

                .contact-form-content .section-subtitle {
                    font-size: 0.85rem;
                    margin-bottom: 1.25rem;
                }

                .form-group {
                    margin-bottom: 1rem;
                }

                .form-row {
                    grid-template-columns: 1fr;
                    gap: 0;
                }

                .form-group label {
                    font-size: 0.85rem;
                    margin-bottom: 0.4rem;
                }

                .form-control {
                    padding: 0.75rem;
                    font-size: 16px;
                    border-radius: 6px;
                }

                .form-group.checkbox {
                    gap: 0.6rem;
                    margin-bottom: 1.25rem;
                }

                .form-group.checkbox label {
                    font-size: 0.85rem;
                }

                button[type="submit"] {
                    padding: 0.85rem 1rem;
                    font-size: 1rem;
                    width: 100%;
                    border-radius: 6px;
                }
            }

            /* Extra small phones - 360px */
            @media (max-width: 360px) {
                .contact-form-section {
                    padding: 1rem 0;
                }

                .contact-form-content {
                    padding: 1.25rem 0.75rem;
                }

                .contact-form-content h2 {
                    font-size: 1.1rem;
                }

                .form-control {
                    padding: 0.7rem;
                    font-size: 14px;
                }

                button[type="submit"] {
                    padding: 0.75rem 0.75rem;
                    font-size: 0.95rem;
                }
            }
        </style>
    </section>

    <!-- FAQ SECTION -->
    <section class="contact-faq" id="contact-faq" style="background: url('{{ asset('image/contact.jpg') }}'); background-size: cover; background-position: center; background-attachment: fixed; padding: 4rem 2rem;">
        <div class="container">
            <h2>Frequently Asked Questions</h2>
            
            <div class="faq-container">
                <div class="faq-item">
                    <div class="faq-question">
                        <h3>How fast can I get a custom cake?</h3>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        <p>For custom orders, we typically need 3-5 business days. However, we can accommodate rush orders (+₱200) if ordered at least 24 hours in advance.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <h3>Do you offer vegan or gluten-free options?</h3>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        <p>Yes! We have a selection of vegan and gluten-free baked goods. Please mention your dietary requirements when ordering, and we'll ensure nothing is cross-contaminated.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <h3>What's your refund policy?</h3>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        <p>We offer full refunds or replacements within 24 hours if there's any quality issue with your order. Custom cakes are non-refundable but can be remade if unsatisfactory.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <h3>Do you do wholesale or bulk orders?</h3>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        <p>Absolutely! We love working with businesses and events. Contact our bulk sales team for special pricing and availability. Minimum orders apply based on item selection.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <h3>How do I participate in Bake It Forward?</h3>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        <p>Every purchase automatically contributes to our Bake It Forward program! A portion of every sale goes directly to local animal shelters. You can also make direct donations.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA SECTION -->
    <section class="contact-cta">
        <div class="container">
                <h2 class="cta-headline">Ready to Order or learn <span class="cta-highlight">more?</span></h2>
            <p>Explore our full range of fresh baked goods or place your custom order today.</p>
            <div class="cta-buttons">
                <a href="{{ path('app_products') }}" class="btn btn-primary btn-lg">View All Products</a>
                <a href="{{ path('app_about') }}" class="btn btn-secondary btn-lg">Meet Our Team</a>
            </div>
        </div>
    </section>

    <script>
        // FAQ Toggle functionality
        document.querySelectorAll('.faq-question').forEach(question => {
            question.addEventListener('click', function() {
                const faqItem = this.parentElement;
                const isActive = faqItem.classList.contains('active');
                
                document.querySelectorAll('.faq-item').forEach(item => {
                    item.classList.remove('active');
                });
                
                if (!isActive) {
                    faqItem.classList.add('active');
                }
            });
        });
    </script>
{% endblock %}
