{% extends 'landing.html.twig' %}

{% block title %}Catalbas Bakery - Freshly Baked Every Morning{% endblock %}

{% block body %}
    <!-- 1. HERO SECTION -->
    <section class="hero" id="hero">
        <div class="hero-background" style="background-image: url('{{ asset('image/breadbackg.jpg') }}'); background-color: var(--primary-brown);">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <h1 class="hero-title">Freshly Baked Every Morning</h1>
                <p class="hero-subtitle">Handmade baked goods made with love, fresh ingredients, and traditional recipes passed down through generations.</p>
                <div class="hero-buttons">
                    <a href="{{ path('app_products') }}" class="btn btn-primary btn-lg">View Products</a>
                    <a href="{{ path('app_products') }}" class="btn btn-secondary btn-lg">Order Now</a>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. FEATURED PRODUCTS -->
    <section class="featured-products" id="featured-products">
        <div class="container">
            <h2>Featured Products</h2>
            <p class="section-subtitle">Discover our most popular baked goods</p>
            
            <div class="products-grid">
                {% if featuredProducts|length > 0 %}
                    {% for product in featuredProducts %}
                        <div class="product-card">
                            <div class="product-image">
                                {% if product.imageUrl %}
                                    <img src="{{ asset('image/' ~ product.imageUrl) }}" alt="{{ product.name }}">
                                {% else %}
                                    <div class="no-image">No Image</div>
                                {% endif %}
                            </div>
                            <div class="product-info">
                                <h3 class="product-name">{{ product.name }}</h3>
                                <p class="product-description">{{ product.description|slice(0, 80) ~ (product.description|length > 80 ? '...' : '') }}</p>
                                <p class="product-price">₱{{ product.price }}</p>
                                <a href="{{ path('app_products') }}" class="btn btn-primary btn-sm">Order Now</a>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p class="no-products">No featured products available at the moment.</p>
                {% endif %}
            </div>
        </div>
    </section>

    <!-- 3. ABOUT THE BAKERY -->
    <section class="about-bakery" id="about-bakery" style="background-image: url('{{ asset('image/wheat.jpg') }}');">
        <div class="about-bakery-overlay"></div>
        <div class="container">
            <div class="about-header">
                {# <img src="{{ asset('image/monochrome.png') }}" alt="Catalbas Bakery Logo" class="about-logo"> #}
                <h2>About Our Bakery</h2>
            </div>
            
            <div class="about-cards-grid">
                <div class="about-card">
                    <div class="about-card-image">
                        <img src="{{ asset('image/wheat.jpg') }}" alt="Fresh Ingredients">
                    </div>
                    <div class="about-card-content">
                        <h3>Fresh Ingredients</h3>
                        <p>Welcome to Catalbas Bakery, where tradition meets passion. For years, we have been dedicated to bringing you the finest baked goods made from the freshest ingredients available.</p>
                    </div>
                </div>
                
                <div class="about-card">
                    <div class="about-card-image">
                        <img src="{{ asset('image/dough.jpg') }}" alt="Master Bakers">
                    </div>
                    <div class="about-card-content">
                        <h3>Master Bakers</h3>
                        <p>Our master bakers use time-honored recipes passed down through generations, combined with modern baking techniques to create an unforgettable experience with every bite. We believe in quality over quantity, which is why each product is carefully crafted with attention to detail.</p>
                    </div>
                </div>
                
                <div class="about-card">
                    <div class="about-card-image">
                        <img src="{{ asset('image/breadbackg.jpg') }}" alt="Made with Love">
                    </div>
                    <div class="about-card-content">
                        <h3>Made with Love</h3>
                        <p>From artisan bread to delicate pastries, every item in our shop tells a story of craftsmanship, dedication, and love for our community. We source our ingredients responsibly and take pride in supporting local suppliers.</p>
                    </div>
                </div>
            </div>

            <div class="about-summary">
                <p>Every loaf, pastry, and treat that leaves our ovens carries with it our commitment to excellence. At Catalbas Bakery, we don't just bake—we create moments of joy, one fresh bite at a time. <strong>Baked daily, delivered with love.</strong></p>
            </div>

            <div class="about-team-section">
                <p class="about-team-description">Get to know the passionate bakers and team members who make every loaf special. Our dedicated crew brings creativity, skill, and heart to everything we do.</p>
                <a href="{{ path('app_about') }}" class="btn btn-primary btn-lg">Meet Our Team</a>
            </div>
        </div>
    </section>

    <!-- 4. BAKE IT FORWARD (DONATION FEATURE) -->
    <section class="bake-it-forward" id="bake-it-forward" style="background-image: url('{{ asset('image/cat.jpg') }}');">
        <div class="bake-it-forward-overlay"></div>
        <div class="container">
            <h2>Bake It Forward - Help Us Help Others</h2>
            <p class="section-subtitle">Every purchase helps provide meals to animals in need</p>
            
            <div class="donation-card">
                <div class="donation-icons">
                    <span class="donation-icon">🐕</span>
                    <span class="donation-icon">🐈</span>
                    <span class="donation-icon">🐕</span>
                </div>

                <div class="donation-message">
                    <p>Our Bake It Forward program donates a portion of every purchase to local animal shelters. Together, we're making a difference in the lives of animals in need.</p>
                </div>
            </div>

            <div class="donation-images-grid">
                <div class="donation-image-card">
                    <div class="donation-image">
                        <img src="{{ asset('image/cat.jpg') }}" alt="Happy Animals">
                    </div>
                    <div class="donation-image-description">
                        <h3>Happy Animals</h3>
                        <p>Your support helps shelters provide nutritious meals to dogs, cats, and other animals in need, bringing them joy and hope for a better future.</p>
                    </div>
                </div>

                <div class="donation-image-card">
                    <div class="donation-image">
                        <img src="{{ asset('image/dogncat3.jpg') }}" alt="Community Care">
                    </div>
                    <div class="donation-image-description">
                        <h3>Community Care</h3>
                        <p>Bake It Forward connects us all—when you buy our baked goods, you're part of a community that cares for the voiceless and feeds those who need it most.</p>
                    </div>
                </div>
            </div>

            <div class="bif-cta-button">
                <a href="{{ path('app_bakeitforward_feature') }}" class="btn btn-primary btn-lg">Get to Know More About Bake It Forward</a>
            </div>
        </div>
    </section>

    <!-- 5. CONTACT US CTA -->
    <section class="contact-us-cta" id="contact-us">
        <div class="cta-container">
            <!-- Left Column: Brand Copy -->
            <div class="cta-left">
                <!-- Pill Tag -->
                <div class="cta-pill">
                    <span class="cta-pill-dot"></span>
                    We'd love to hear from you
                </div>
                
                <!-- Headline -->
                <h2 class="cta-headline">Still hungry for <span class="cta-highlight">more?</span></h2>
                
                <!-- Body Text -->
                <p class="cta-body">Whether it's a custom cake, a bulk bread order, or just a question about today's bake — we're just a message away.</p>
                
                <!-- Trust Strip -->
                <div class="cta-trust-strip">
                    <div class="cta-stat">
                        <div class="cta-stat-number">24h</div>
                        <div class="cta-stat-label">Response time</div>
                    </div>
                    <div class="cta-stat">
                        <div class="cta-stat-number">Daily</div>
                        <div class="cta-stat-label">Fresh bakes</div>
                    </div>
                    <div class="cta-stat">
                        <div class="cta-stat-number">Free</div>
                        <div class="cta-stat-label">Consultations</div>
                    </div>
                </div>
            </div>
            
            <!-- Right Column: Action Cards -->
            <div class="cta-right">
                <!-- Card 1: Send Message -->
                <div class="cta-card">
                    <div class="cta-card-icon cta-card-icon-message">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </div>
                    <h3 class="cta-card-title">Send us a message</h3>
                    <p class="cta-card-description">Have a question or a special request? Drop us a note and we'll get back to you fresh.</p>
                    <a href="{{ path('app_contact') }}" class="cta-card-btn cta-card-btn-primary">Get in touch</a>
                </div>
                
                <!-- Card 2: Contact Info -->
                <div class="cta-card">
                    <div class="cta-card-icon cta-card-icon-location">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                    </div>
                    <h3 class="cta-card-title">Find us or call us</h3>
                    <p class="cta-card-description">Prefer to visit or call? See our full contact details, hours, and location.</p>
                    <a href="{{ path('app_contact') }}" class="cta-card-btn cta-card-btn-secondary">View contact info</a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
