{% extends 'base.html.twig' %}

{% block title %}Activity Log{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .new-row-flash {
        animation: flashRow 2s ease;
    }
    @keyframes flashRow {
        0%   { background-color: #dbeafe; }
        100% { background-color: transparent; }
    }
</style>
{% endblock %}

{% block body %}
<div class="activity-log-container">
    <h1>Activity Log</h1>

    <div class="filter-form">
        <form method="get" action="{{ path('app_activity_log') }}">
            <div class="filter-row">
                <div class="filter-group">
                    <label for="user">User:</label>
                    <select name="user" id="user">
                        <option value="">All Users</option>
                        {% for user in users %}
                            <option value="{{ user.id }}" {% if filters.user is defined and filters.user == user.id %}selected{% endif %}>{{ user.username }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filter-group">
                    <label for="action">Action:</label>
                    <select name="action" id="action">
                        <option value="">All Actions</option>
                        {% for actionOption in actions %}
                            <option value="{{ actionOption }}" {% if filters.action is defined and filters.action == actionOption %}selected{% endif %}>{{ actionOption }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filter-group">
                    <label for="date_from">Date From:</label>
                    <input type="date" name="date_from" id="date_from" value="{{ filters.date_from ?? '' }}">
                </div>

                <div class="filter-group">
                    <label for="date_to">Date To:</label>
                    <input type="date" name="date_to" id="date_to" value="{{ filters.date_to ?? '' }}">
                </div>

                <div class="filter-group">
                    <button type="submit">Filter</button>
                    <a href="{{ path('app_activity_log') }}" class="btn-clear">Clear Filters</a>
                </div>
            </div>
        </form>
    </div>

    <table class="activity-log-table">
        <thead>
            <tr>
                <th>id</th>
                <th>Username</th>
                <th>Role</th>
                <th>Action</th>
                <th>Target Data</th>
                <th>Date & Time</th>
            </tr>
        </thead>
        <tbody>
            {% for log in activity_logs %}
                <tr>
                    <td>{{ log.id }}</td>
                    <td>{{ log.user.username }}</td>
                    <td>{{ log.role }}</td>
                    <td>{{ log.action }}</td>
                    <td>{{ log.targetData }}</td>
                    <td>{{ log.createdAt|date('Y-m-d H:i:s') }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">No logs found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<script>
    window.onNewActivityLog = function(data) {
        // Don't add row if filters are active — it would be misleading
        const params = new URLSearchParams(window.location.search);
        if (params.get('user') || params.get('action') || params.get('date_from') || params.get('date_to')) {
            return;
        }

        const tbody = document.querySelector('.activity-log-table tbody');
        if (!tbody) return;

        // Remove "No logs found" row if present
        const emptyRow = tbody.querySelector('td[colspan]');
        if (emptyRow) emptyRow.closest('tr').remove();

        const row = document.createElement('tr');
        row.className = 'new-row-flash';
        row.innerHTML = `
            <td>${data.id}</td>
            <td>${data.username}</td>
            <td>${data.role}</td>
            <td>${data.action}</td>
            <td>${data.targetData}</td>
            <td>${data.createdAt}</td>
        `;
        tbody.insertBefore(row, tbody.firstChild);
    };
</script>
{% endblock %}
