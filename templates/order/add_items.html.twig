{% extends 'base.html.twig' %}

{% block title %}Add Items to Order #{{ order.id }}{% endblock %}

{% block body %}
<div class="main-content">
    <div class="content-card">
        <h1>Add Items to Order #{{ order.id }}</h1>

        <div class="mb-4">
            <p><strong>Order Number:</strong> {{ order.orderNumber }}</p>
            <p><strong>Customer:</strong> {{ order.customerName }}</p>
            <p><strong>Current Total:</strong> ${{ order.totalAmount|number_format(2) }}</p>
        </div>

        <h2>Add New Item</h2>
        {{ form_start(form) }}
            {{ form_row(form.product) }}
            {{ form_row(form.quantity) }}
            <button type="submit" class="btn btn-primary">Add Item</button>
        {{ form_end(form) }}

        <div class="mt-4">
            <a href="{{ path('app_order_show', {'id': order.id}) }}" class="btn btn-secondary">View Order</a>
            <a href="{{ path('app_order_index') }}" class="btn btn-secondary">Back to Orders</a>
        </div>

        {% if order.orderItems|length > 0 %}
        <h2 class="mt-4">Current Items</h2>
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                {% for item in order.orderItems %}
                <tr>
                    <td>{{ item.product.name }}</td>
                    <td>{{ item.quantity }}</td>
                    <td>${{ item.price|number_format(2) }}</td>
                    <td>${{ item.subtotal|number_format(2) }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>
</div>
{% endblock %}