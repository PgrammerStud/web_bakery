{% extends 'base.html.twig' %}

{% block title %}Order index{% endblock %}

{% block body %}
    <h1>Order index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Order Number</th>
                <th>Customer Name</th>
                <th>Customer Contact</th>
                <th>Status</th>
                <th>Total Amount</th>
                <th>Payment Method</th>
                <th>Notes</th>
                <th>Items</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for order in orders %}
            <tr>
                <td>{{ order.id }}</td>
                <td>{{ order.orderNumber }}</td>
                <td>{{ order.customerName }}</td>
                <td>{{ order.customerContact }}</td>
                <td>{{ order.status }}</td>
                <td>{{ order.totalAmount }}</td>
                <td>{{ order.paymentMethod }}</td>
                <td>{{ order.notes }}</td>

<td>
    {% if order.orderItems|length > 0 %}
        <ul>
            {% for item in order.orderItems %}
                <li>
                    {{ item.product.name }}
                    × {{ item.quantity }}
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <em>No items</em>
    {% endif %}
</td>

<td>
    <a href="{{ path('app_order_show', {'id': order.id}) }}">show</a>
    {% if is_granted('ROLE_ADMIN') or order.createdBy == app.user %}
        <a href="{{ path('app_order_edit', {'id': order.id}) }}">edit</a>
        {{ include('order/_delete_form.html.twig') }}
    {% endif %}
</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_order_new') }}">Create new</a>
{% endblock %}
