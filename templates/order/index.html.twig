{% extends 'base.html.twig' %}

{% block title %}Order index{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
{% endblock %}

{% block body %}
    <h1>Order Management</h1>

    <table id="orders-table" class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Order Number</th>
                <th>Customer Name</th>
                <th>Customer Contact</th>
                <th>Status</th>
                <th>Total Amount</th>
                <th>Payment Method</th>
                <th>Notes</th>
                <th>Items</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for order in orders %}
            <tr>
                <td>{{ order.id }}</td>
                <td>{{ order.orderNumber }}</td>
                <td>{{ order.customerName }}</td>
                <td>{{ order.customerContact }}</td>
                <td>{{ order.status }}</td>
                <td>{{ order.totalAmount }}</td>
                <td>{{ order.paymentMethod }}</td>
                <td>{{ order.notes }}</td>

<td>
    {% if order.orderItems|length > 0 %}
        <ul>
            {% for item in order.orderItems %}
                <li>
                    {{ item.product.name }}
                    × {{ item.quantity }}
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <em>No items</em>
    {% endif %}
</td>

<td class="actions">
    <a href="{{ path('app_order_show', {'id': order.id}) }}" class="btn btn-show">show</a>
    {% if is_granted('ROLE_ADMIN') or order.createdBy == app.user %}
        <a href="{{ path('app_order_edit', {'id': order.id}) }}" class="btn btn-edit">edit</a>
        {{ include('order/_delete_form.html.twig') }}
    {% endif %}
</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_order_new') }}" class="btn btn-create-new">Create new</a>

<script>
$(document).ready(function() {
    $('#orders-table').DataTable();
});
</script>
{% endblock %}
