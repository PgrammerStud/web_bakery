{% extends 'base.html.twig' %}

{% block title %}Delete Delivery{% endblock %}

{% block body %}
<div class="container">
    <h1>Delete Delivery</h1>

    <p>Are you sure you want to delete this delivery?</p>

    <form method="post" action="{{ path('app_delivery_delete', {'id': delivery.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ delivery.id) }}">
        <button class="btn btn-delete">Delete</button>
    </form>

    <a href="{{ path('app_delivery_index') }}" class="btn">back to list</a>
</div>
{% endblock %}
