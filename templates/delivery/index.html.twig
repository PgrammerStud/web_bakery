{% extends 'base.html.twig' %}

{% block title %}Delivery Management{% endblock %}

{% block body %}
<div class="container">
    <h1>Delivery Management</h1>

    <div class="filters">
        <form method="get" class="filter-form">
            <label for="status">Status:</label>
            <select name="status" id="status">
                <option value="">All</option>
                <option value="pending" {% if status_filter == 'pending' %}selected{% endif %}>Pending</option>
                <option value="in_transit" {% if status_filter == 'in_transit' %}selected{% endif %}>In Transit</option>
                <option value="delivered" {% if status_filter == 'delivered' %}selected{% endif %}>Delivered</option>
                <option value="returned" {% if status_filter == 'returned' %}selected{% endif %}>Returned</option>
            </select>
            <label for="order">Order #:</label>
            <input type="text" name="order" id="order" value="{{ order_filter }}">
            <button type="submit" class="btn">Filter</button>
        </form>
        <a href="{{ path('app_delivery_new') }}" class="btn btn-primary">Add New Delivery</a>
    </div>

    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Order #</th>
                    <th>Rider</th>
                    <th>Delivery Date</th>
                    <th>Status</th>
                    <th>Fee</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="delivery-table-body">
                {% for delivery in deliveries %}
                <tr data-delivery-id="{{ delivery.id }}">
                    <td>{{ delivery.id }}</td>
                    <td>{{ delivery.orders ? delivery.orders.orderNumber : 'N/A' }}</td>
                    <td>
                        {% if delivery.rider %}
                            {% set rider = delivery.rider %}
                            {% set name = (rider.firstname ?? '') ~ ' ' ~ (rider.lastname ?? '') %}
                            {{ name|trim ?: rider.email ?: rider.username }}
                            <small style="color: #999; display: block;">ID: {{ rider.id }}</small>
                        {% else %}
                            <span style="color: #ccc;">No rider</span>
                        {% endif %}
                    </td>
                    <td>{{ delivery.deliveryDate|date('Y-m-d H:i') }}</td>
                    <td class="status-cell">
                        <span class="badge {{ delivery.status.getColorClass() }}">{{ delivery.status.getLabel() }}</span>
                    </td>
                    <td>${{ delivery.deliveryFee|number_format(2) }}</td>
                    <td>
                        <a href="{{ path('app_delivery_edit', {'id': delivery.id}) }}" class="btn btn-secondary">Edit</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
(function () {
    // ── Status label + CSS class maps (mirror your PHP Enum) ──
    const STATUS_LABELS = {
        pending:     'Pending',
        in_transit:  'In Transit',
        delivered:   'Delivered',
        returned:    'Returned',
        // add others your DeliveryStatus enum has
    };

    const STATUS_CLASSES = {
        pending:    'badge-warning',
        in_transit: 'badge-info',
        delivered:  'badge-success',
        returned:   'badge-danger',
    };

    function labelFor(status)  { return STATUS_LABELS[status]  ?? status; }
    function classFor(status)  { return STATUS_CLASSES[status] ?? 'badge-secondary'; }

    // ── Flash a row briefly so the user sees it changed ───────
    function flashRow(row) {
        row.style.transition = 'background 0.3s';
        row.style.background = '#fffbe6';
        setTimeout(() => { row.style.background = ''; }, 1500);
    }

    // ── Handle a delivery_update event ────────────────────────
    function applyDeliveryUpdate(data) {
        // The backend sends { type, totalDelivered, totalPending, delivery? }
        // When a specific delivery changed, `delivery` carries { id, status }
        if (!data.delivery) return;

        const { id, status } = data.delivery;
        const row = document.querySelector(`tr[data-delivery-id="${id}"]`);
        if (!row) {
            // New delivery not in the table yet — reload so it appears
            window.location.reload();
            return;
        }

        const cell = row.querySelector('.status-cell');
        if (!cell) return;

        cell.innerHTML = `<span class="badge ${classFor(status)}">${labelFor(status)}</span>`;
        flashRow(row);
    }

    // ── Subscribe to Mercure ──────────────────────────────────
    const mercureUrl = new URL('{{ mercure_url }}');
    mercureUrl.searchParams.append('topic', '/delivery/update');

    const es = new EventSource(mercureUrl.toString(), { withCredentials: true });

    es.addEventListener('message', (event) => {
        try {
            const data = JSON.parse(event.data);
            if (data.type === 'delivery_update') {
                applyDeliveryUpdate(data);
            }
        } catch (e) {
            console.warn('Mercure parse error:', e);
        }
    });

    es.addEventListener('error', () => {
        console.warn('Mercure connection lost — will auto-reconnect.');
    });
})();
</script>
{% endblock %}