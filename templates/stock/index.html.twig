{% extends 'base.html.twig' %}

{% block title %}Stock index{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
{% endblock %}

{% block body %}
    <h1>Stock Management</h1>

    <table id="stocks-table" class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Quantity</th>
                <th>Created_at</th>
                <th>Updated_at</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for stock in stocks %}
            <tr>
                <td>{{ stock.id }}</td>
                <td>{{ stock.quantity }}</td>
                <td>{{ stock.createdAt ? stock.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ stock.updatedAt ? stock.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td class="actions">
                    <a href="{{ path('app_stock_show', {'id': stock.id}) }}" class="btn btn-show">show</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_stock_edit', {'id': stock.id}) }}" class="btn btn-edit">edit</a>
                        {{ include('stock/_delete_form.html.twig') }}
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_stock_new') }}" class="btn btn-create-new">Create new</a>

<script>
$(document).ready(function() {
    $('#stocks-table').DataTable();
});
</script>
{% endblock %}
